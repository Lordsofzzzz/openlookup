map $http_cf_connecting_ip $visitor_ip {
    ""      $remote_addr;
    default $http_cf_connecting_ip;
}

map $uri $full_lookup_key {
    ~^/api/v1/domain/[^/]+$          $visitor_ip;
    ~^/api/v1/domain/[^/]+/stream$   $visitor_ip;
    default                          "";
}

map $uri $section_retry_key {
    ~^/api/v1/domain/[^/]+/sections/[^/]+$  $visitor_ip;
    default                                "";
}

map $uri $retry_after {
    ~^/api/v1/domain/[^/]+$                 6;
    ~^/api/v1/domain/[^/]+/stream$          6;
    ~^/api/v1/domain/[^/]+/sections/[^/]+$  2;
    default                                 2;
}

limit_req_zone $full_lookup_key zone=full_lookup:10m rate=10r/m;
limit_req_zone $section_retry_key zone=section_retry:10m rate=30r/m;
limit_req_status 429;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        access_log off;
        limit_req zone=full_lookup burst=4 nodelay;
        limit_req zone=section_retry burst=10 nodelay;
        error_page 429 = @rate_limited;
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 75s;
    }

    location @rate_limited {
        default_type application/json;
        add_header Retry-After $retry_after always;
        return 429 '{"detail":"Rate limit exceeded. Try again later."}';
    }

    location / {
        access_log off;
        try_files $uri $uri/ /index.html;
    }
}
