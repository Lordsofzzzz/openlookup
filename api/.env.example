# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Per-process limits. Configure a shared limiter/cache before multi-worker deployment.
MAX_CONCURRENT_LOOKUPS=12
RATE_LIMIT_PER_MINUTE=30
REFRESH_LIMIT_PER_MINUTE=3

# Optional API key for the Certspotter fallback. Keep this on the API host only.
# CERTSPOTTER_API_KEY=
